{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dddnd.app/schema/v1/stakeholder-reaction-rule.schema.json",
  "title": "DDDnD stakeholder reaction rule",
  "description": "Generated from the DDDnD content validator (pack format 1). Some rules (non-blank text, forbidden characters, cross-field rules) are only checked by the game and CLI validator.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional link to this schema, for editor support. Ignored by the game."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,64}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999
    },
    "name": {
      "type": "string",
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 600
    },
    "condition_description": {
      "type": "string",
      "maxLength": 240
    },
    "condition": {
      "type": "object",
      "properties": {
        "target_type": {
          "type": "string",
          "enum": [
            "score",
            "stakeholder"
          ]
        },
        "target_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,64}$"
        },
        "operator": {
          "type": "string",
          "enum": [
            "<",
            "<=",
            ">",
            ">=",
            "=",
            "=="
          ]
        },
        "value": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 1000
        }
      },
      "required": [
        "target_type",
        "target_id",
        "operator",
        "value"
      ],
      "additionalProperties": false
    },
    "score_changes": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "score_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,64}$"
          },
          "delta": {
            "type": "integer",
            "minimum": -100,
            "maximum": 100
          }
        },
        "required": [
          "score_id",
          "delta"
        ],
        "additionalProperties": false
      }
    },
    "stakeholder_changes": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stakeholder_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,64}$"
          },
          "delta": {
            "type": "integer",
            "minimum": -100,
            "maximum": 100
          }
        },
        "required": [
          "stakeholder_id",
          "delta"
        ],
        "additionalProperties": false
      }
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    }
  },
  "required": [
    "id",
    "version",
    "name",
    "description",
    "condition_description",
    "condition",
    "score_changes"
  ],
  "additionalProperties": false
}
