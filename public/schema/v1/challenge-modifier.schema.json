{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dddnd.app/schema/v1/challenge-modifier.schema.json",
  "title": "DDDnD challenge modifier",
  "description": "Generated from the DDDnD content validator (pack format 1). Some rules (non-blank text, forbidden characters, cross-field rules) are only checked by the game and CLI validator.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional link to this schema, for editor support. Ignored by the game."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,64}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999
    },
    "name": {
      "type": "string",
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 600
    },
    "flavor_text": {
      "type": "string",
      "maxLength": 400
    },
    "score_adjustments": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9_]{1,64}$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": -100,
        "maximum": 100
      }
    },
    "stakeholder_satisfaction_override": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "turn_adjustment": {
      "type": "integer",
      "minimum": -20,
      "maximum": 20
    }
  },
  "required": [
    "id",
    "version",
    "name",
    "description"
  ],
  "additionalProperties": false
}
