    "cards/ledger_add_transactional_outbox-v1.json": {
      "id": "ledger_add_transactional_outbox",
      "version": 1,
      "name": "Add a Transactional Outbox",
      "description": "Publish payment events from the same transaction that records the payment, so nothing is charged without being announced.",
      "flavor_text": "No more 'we charged them but never told anyone'.",
      "score_changes": [
        {
          "score_id": "user_trust",
          "delta": 4
        },
        {
          "score_id": "maintainability",
          "delta": 4
        },
        {
          "score_id": "delivery_confidence",
          "delta": -2
        },
        {
          "score_id": "budget",
          "delta": -4
        }
      ],
      "delayed_effect_refs": [
        {
          "id": "ledger_outbox_settles",
          "version": 1
        }
      ],
      "usage_limit": 1,
      "style_tags": [
