    "scenarios/ledger_payments_monolith-v1.json": {
      "id": "ledger_payments_monolith",
      "version": 1,
      "name": "The Gilded Ledger",
      "description": "Gilded Ledger Co. runs every charge, refund, and chargeback through one payments monolith and one shared database. The regulator's audit is coming, and nobody can say where a refund's data actually lives.",
      "short_description": "Untangle a payments monolith before the regulator's audit.",
      "flavor_text": "Every refund is a negative payment. Every payment is a special case.",
